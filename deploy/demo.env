# Placeholders. Nothing here protects anything real, and no stack started by `immune up` uses them: every project,
# the built-in demo included, gets random secrets in <runtime>/secrets.env (0600) on its first `immune up`.
# Still read as: the env_file of `docker compose down` when no stack was ever started, and the fallback of
# `python -m fleet` / `python -m pipeline` when they are run by hand without these variables.
PROD_APP_SECRET=prod-secret-demo-4f1c
SHADOW_APP_SECRET=shadow-secret-demo-9a2e
ADMIN_TOKEN=admin-demo-7d3b
BUS_TOKEN=bus-demo-1c8f
BUS_URL=http://dashboard:8090
RUN_ID=dev
