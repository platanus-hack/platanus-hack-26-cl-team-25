{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Evidence (clone -> gateway, and data of oracle.fired)",
 "type":"object","required":["clone","rid","mode","release","verdict","request","status","events"],
 "properties":{
  "clone":{"type":"string"},"rid":{"type":"string"},"mode":{"enum":["L1","L2"]},"release":{"type":"string"},
  "verdict":{"const":"oracle"},
  "uid":{"type":["integer","null"]},"role":{"type":["string","null"]},
  "request":{"type":"object","required":["method","path","query","headers","body_b64"],
    "properties":{"method":{"type":"string"},"path":{"type":"string"},"query":{"type":"string"},
      "headers":{"type":"object","additionalProperties":{"type":"string"}},"body_b64":{"type":"string"}}},
  "status":{"type":"integer"},
  "events":{"type":"array","minItems":1,"items":{"type":"object","required":["oracle","detail","stack"],
    "properties":{"oracle":{"enum":["sql","file","proc","net","owner","acl","mfa","xss","ssrf","cmdi","ssti","deser","xxe","redirect"]},"detail":{"type":"object"},
      "stack":{"type":"array","items":{"type":"object","required":["file","line","func"],
        "properties":{"file":{"type":"string"},"line":{"type":"integer"},"func":{"type":"string"}}}}}}},
  "pre_state_b64":{"type":["string","null"],"description":"sqlite bytes before the request (L2). null = seed state."},
  "session":{"type":["string","null"],"description":"added by the gateway"}}}
