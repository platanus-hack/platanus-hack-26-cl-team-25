{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Proof of concept",
 "type":"object","required":["incident","release","state_b64","requests","expect"],
 "properties":{
  "incident":{"type":"string"},"release":{"type":"string"},
  "state_b64":{"type":["string","null"],"description":"sqlite bytes to start from; null = shadow seed"},
  "requests":{"type":"array","minItems":1,"items":{"type":"object","required":["method","path","query","headers","body_b64"],
    "properties":{"method":{"type":"string"},"path":{"type":"string"},"query":{"type":"string"},
      "headers":{"type":"object"},"body_b64":{"type":"string"},"uid":{"type":["integer","null"]},"role":{"type":["string","null"]}}}},
  "expect":{"type":"object","required":["oracle"],"properties":{"oracle":{"enum":["sql","file","proc","net","owner"]},
    "sink":{"type":"object","properties":{"file":{"type":"string"},"line":{"type":"integer"}}}}}}}
