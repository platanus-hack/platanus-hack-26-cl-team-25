#!/usr/bin/env bash
# immune CLI (contracts/product.md §5): python -m immune with this repository's venv.
set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
PY="${IMMUNE_VENV_DIR:-$ROOT/.venv}/bin/python"
[ -x "$PY" ] || { echo "immune: Python executable unavailable at $PY; run $ROOT/install.sh" >&2; exit 1; }
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m immune "$@"
